{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otis.local/schemas/adaptive_hybrid_regulation_v1.schema.json",
  "title": "OTIS adaptive hybrid regulation policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "status",
    "oscillator_identity",
    "bindings",
    "frequency_control",
    "topology",
    "maintenance_selection",
    "maintenance_arithmetic",
    "correction_debt",
    "gnss_metadata_hold",
    "global_authority_limits",
    "failure_isolation",
    "claims_not_made"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"const": "OTIS_ADAPTIVE_HYBRID_REGULATION_V1"},
    "status": {"const": "selected_production_policy"},
    "oscillator_identity": {"const": "CX317"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_classification",
        "frequency_estimator",
        "phase_estimator",
        "plant_model"
      ],
      "properties": {
        "response_classification": {"const": "profiles/discipline/response_classification_v1.json"},
        "frequency_estimator": {"const": "profiles/estimators/pps_gated_frequency_estimator_v1.json"},
        "phase_estimator": {"const": "profiles/estimators/relative_phase_estimator_v1.json"},
        "plant_model": {"const": "profiles/plant_models/pps_gated_oscillator_plant_v1.json"}
      }
    },
    "frequency_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "status", "frequency_estimator_id", "parameters", "authority"],
      "properties": {
        "policy_id": {"const": "OTIS_FREQUENCY_CONTROL_POLICY_V1"},
        "status": {"const": "selected_production_component"},
        "frequency_estimator_id": {"const": "OTIS_PPS_GATED_FREQUENCY_ESTIMATOR_V1"},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nominal_frequency_hz",
            "gain_min_hz_per_code",
            "gain_nominal_hz_per_code",
            "gain_max_hz_per_code",
            "estimator_span_s",
            "minimum_applied_cadence_s",
            "settling_exclusion_s",
            "fresh_support_after_settling_s",
            "startup_warmup_s",
            "error_deadband_hz",
            "integrator_gain_codes_per_hz_per_decision",
            "maximum_update_codes",
            "dac_min_code",
            "dac_max_code"
          ],
          "properties": {
            "nominal_frequency_hz": {"const": 10000000},
            "gain_min_hz_per_code": {"const": 0.00016357422282453626},
            "gain_nominal_hz_per_code": {"const": 0.00017008467693813145},
            "gain_max_hz_per_code": {"const": 0.00017334010044578463},
            "estimator_span_s": {"const": 600},
            "minimum_applied_cadence_s": {"const": 1800},
            "settling_exclusion_s": {"const": 900},
            "fresh_support_after_settling_s": {"const": 600},
            "startup_warmup_s": {"const": 1800},
            "error_deadband_hz": {"const": 0.006249995628992717},
            "integrator_gain_codes_per_hz_per_decision": {"const": 2884.5027706464516},
            "maximum_update_codes": {"const": 21},
            "dac_min_code": {"const": 43008},
            "dac_max_code": {"const": 43776}
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "arming_required",
            "one_request_outstanding",
            "automatic_retry",
            "automatic_restore",
            "gnss_qualification_required",
            "D14_reference_required",
            "D8_count_required",
            "D10_external_event_excluded"
          ],
          "properties": {
            "arming_required": {"const": true},
            "one_request_outstanding": {"const": true},
            "automatic_retry": {"const": false},
            "automatic_restore": {"const": false},
            "gnss_qualification_required": {"const": true},
            "D14_reference_required": {"const": true},
            "D8_count_required": {"const": true},
            "D10_external_event_excluded": {"const": true}
          }
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_input",
        "oscillator_count_input",
        "forwarded_output",
        "diagnostic_monitor",
        "external_event_input",
        "gnss_role",
        "gnss_baud",
        "serial_owner_count"
      ],
      "properties": {
        "reference_input": {"const": "D14_authoritative_PPS"},
        "oscillator_count_input": {"const": "D8_authoritative_oscillator_count"},
        "forwarded_output": {"const": "D9_zero_control_authority"},
        "diagnostic_monitor": {"const": "D6_fail_local_zero_control_authority"},
        "external_event_input": {"const": "D10_optional_EVT_zero_reference_and_control_authority"},
        "gnss_role": {"const": "qualification_metadata_from_same_receiver_as_D14_never_timing_authority"},
        "gnss_baud": {"const": 115200},
        "serial_owner_count": {"const": 1}
      }
    },
    "maintenance_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_tight_state",
        "requires_phase_material_decision",
        "selected_frequency_estimator",
        "window_s",
        "frontier_support",
        "contiguous_frontier",
        "overlap_frontier",
        "gap_frontier",
        "required_consecutive_same_sign_windows",
        "same_identity_fields"
      ],
      "properties": {
        "requires_tight_state": {"const": "TIGHT_INSIDE"},
        "requires_phase_material_decision": {"const": false},
        "selected_frequency_estimator": {"const": "OTIS_PPS_GATED_FREQUENCY_ESTIMATOR_V1"},
        "window_s": {"const": 600},
        "frontier_support": {"const": "(opening_closing]"},
        "contiguous_frontier": {"const": "next_opening_eq_prior_closing"},
        "overlap_frontier": {"const": "next_opening_lt_prior_closing"},
        "gap_frontier": {"const": "next_opening_gt_prior_closing"},
        "required_consecutive_same_sign_windows": {"const": 2},
        "same_identity_fields": {
          "const": [
            "capture_session",
            "applied_code",
            "dac_epoch",
            "phase_epoch_and_validity",
            "selected_estimator_identity"
          ]
        }
      }
    },
    "maintenance_arithmetic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frequency_centre_units",
        "phase_centre_units",
        "combined_centre_units",
        "unit_hz",
        "closed_interval_half_width_units",
        "strict_sign",
        "conservative_maximum_plant_gain_hz_per_code",
        "no_zero_cross_cap",
        "maximum_step_codes",
        "rounding",
        "authoritative_fixed_point_unit",
        "picocode_reduced_numerator",
        "picocode_reduced_denominator",
        "conversion",
        "maximum_absolute_combined_centre_units"
      ],
      "properties": {
        "frequency_centre_units": {"const": "-36*accumulated_edge_error_counts"},
        "phase_centre_units": {"const": "clamp(-relative_phase_cycles,-36,+36)"},
        "combined_centre_units": {"const": "frequency_centre_units+phase_centre_units"},
        "unit_hz": {"const": "1/21600"},
        "closed_interval_half_width_units": {"const": 18},
        "strict_sign": {"const": "positive_if_lower_gt_0_negative_if_upper_lt_0_otherwise_zero_containing"},
        "conservative_maximum_plant_gain_hz_per_code": {"const": "173340101/1000000000000"},
        "no_zero_cross_cap": {"const": "floor(nearest_zero_interval_units*1000000000000/(21600*173340101))"},
        "maximum_step_codes": {"const": 21},
        "rounding": {"const": "half_away_from_zero"},
        "authoritative_fixed_point_unit": {"const": "signed_integer_picocode_1e_minus_12_code"},
        "picocode_reduced_numerator": {"const": 625000000000000000000},
        "picocode_reduced_denominator": {"const": 4680182727},
        "conversion": {"const": "checked_signed_128_bit_quotient_remainder"},
        "maximum_absolute_combined_centre_units": {"const": 332041393326771929124}
      }
    },
    "correction_debt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "maximum_absolute_total_picocodes",
        "component_tags",
        "commit",
        "tag_allocation",
        "preserve_without_accrual",
        "reset_both",
        "phase_loss_or_epoch_change",
        "unknown_or_incomplete_application"
      ],
      "properties": {
        "enabled": {"const": true},
        "maximum_absolute_total_picocodes": {"const": 500000000000},
        "component_tags": {"const": ["FLL", "PLL"]},
        "commit": {"const": "only_after_exact_acceptance_application_code_epoch_and_first_dependent_consumer"},
        "tag_allocation": {"const": "magnitude_weighted_by_current_raw_component_plus_prior_same_component_debt_with_PLL_as_exact_remainder"},
        "preserve_without_accrual": {
          "const": [
            "persistence_hold",
            "cadence_hold",
            "source_overlap",
            "source_gap_restart",
            "settling_hold",
            "reference_or_metadata_hold",
            "request_rejection_or_expiry",
            "response_pending_or_completion"
          ]
        },
        "reset_both": {
          "const": [
            "zero_containing_or_opposite_interval",
            "phase_material_or_outside_tight_ordinary_path",
            "capture_session_or_selected_estimator_change",
            "new_policy_activation"
          ]
        },
        "phase_loss_or_epoch_change": {"const": "preserve_FLL_discard_PLL"},
        "unknown_or_incomplete_application": {"const": "fail_static"}
      }
    },
    "gnss_metadata_hold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recoverable_serial_metadata_anomaly",
        "no_forced_glitch",
        "debt",
        "requalification",
        "run_terminal"
      ],
      "properties": {
        "recoverable_serial_metadata_anomaly": {"const": "hold_new_correction_preserve_last_confirmed_code_and_D14_D8_capture"},
        "no_forced_glitch": {"const": true},
        "debt": {"const": "freeze_without_accrual"},
        "requalification": {"const": "fresh_same_receiver_metadata_then_two_complete_causally_later_maintenance_windows"},
        "run_terminal": {"const": false}
      }
    },
    "global_authority_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_automatic_applications",
        "maximum_cumulative_absolute_movement_codes",
        "maximum_combined_step_codes",
        "minimum_applied_cadence_s",
        "minimum_code",
        "maximum_code",
        "maximum_outstanding_requests",
        "automatic_retry",
        "automatic_restoration"
      ],
      "properties": {
        "maximum_automatic_applications": {"const": 336},
        "maximum_cumulative_absolute_movement_codes": {"const": 7056},
        "maximum_combined_step_codes": {"const": 21},
        "minimum_applied_cadence_s": {"const": 1800},
        "minimum_code": {"const": 43008},
        "maximum_code": {"const": 43776},
        "maximum_outstanding_requests": {"const": 1},
        "automatic_retry": {"const": false},
        "automatic_restoration": {"const": false}
      }
    },
    "failure_isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "D10_absence_noise_invalidity_or_overflow",
        "D6_failure",
        "D9_failure",
        "host_discrepancy",
        "shared_D14_D8_fault"
      ],
      "properties": {
        "D10_absence_noise_invalidity_or_overflow": {"const": "degrade_external_event_evidence_only"},
        "D6_failure": {"const": "degrade_diagnostic_monitor_only"},
        "D9_failure": {"const": "forwarded_output_fault_without_timing_authority"},
        "host_discrepancy": {"const": "review_hold_preserve_capture_and_last_confirmed_code"},
        "shared_D14_D8_fault": {"const": "fail_static"}
      }
    },
    "claims_not_made": {
      "const": [
        "calibrated_absolute_frequency_accuracy",
        "UTC_or_absolute_time_accuracy",
        "cross_phase_epoch_continuity",
        "D10_reference_or_control_authority"
      ]
    }
  }
}
