      "configuration_sha256",
      "estimate_age_s",
      "qualification_state",
      "uncertainty_status",
      "reason_codes"
    ],
    "raw_and_filtered_fields_must_remain_distinct": true,
    "calibrated_uncertainty_default": "unavailable",
    "may_join_epochs_by_guessed_offset": false
  },
  "phase_epoch_policy": {
    "start_new_epoch_on": [
      "capture_session_change",
      "reset",
      "unbridgeable_reference_discontinuity",
      "snapshot_sequence_or_association_discontinuity",
      "ambiguous_counter_wrap"
    ],
    "preserve_epoch_on": [
      "healthy_dac_epoch_transition",
      "visible_phase_step_with_valid_snapshot_and_reference_continuity"
    ],
    "invalidating_conditions": [
      "missing_duplicate_short_or_long_pps",
      "invalid_or_stale_gnss_qualification",
      "snapshot_gap_or_association_mismatch",
      "counter_zero_saturation_or_ambiguous_wrap",
      "fifo_dma_ring_parser_or_non_droppable_queue_loss",
      "capture_transport_or_session_discontinuity"
    ],
    "no_retroactive_repair": true
  },
  "hybrid_preview_decision": {
    "record_type": "HPR",
    "record_schema_version": 1,
    "formula": "combined_frequency_error_hz=frequency_term_hz+clamp(-relative_phase_cycles/pull_in_time_s,-phase_bias_cap_hz,+phase_bias_cap_hz)",
    "phase_bias_sign_check": "positive_relative_phase_requires_negative_phase_frequency_bias",
    "pull_in_times_s": [3600, 10800, 21600],
    "absolute_phase_bias_caps_hz": [0.0016666666666666668, 0.0033333333333333335],
    "frequency_band_semantics": [
      "historical_v2",
      "tight_hysteretic_two_count_entry_four_count_release"
    ],
    "states": [
      "RELATIVE_PHASE_ACQUIRE",
      "FREQUENCY_ACQUIRED_PREVIEW",
      "HYBRID_TRACKING_PREVIEW",
      "PHASE_STEP_HOLD_PREVIEW",
      "REFERENCE_LOST_PREVIEW",
      "RECOVER_PREVIEW",
      "FAULT_PREVIEW"
    ],
    "required_fields": [
      "candidate_id",
      "source_phase_estimate",
      "source_frequency_estimate",
      "frequency_term_hz",
      "phase_bias_hz",
      "combined_frequency_error_hz",
      "counterfactual_delta_codes",
      "counterfactual_code",
      "modeled_not_observed_after_divergence",
      "preview_state",
      "decision_reason",
      "actionable",
      "actuation_authorized",
      "authorization_consumed"
    ],
    "one_coherent_counterfactual_output": true,
    "independent_fll_and_pll_actuators": false,
    "state_named_locked_permitted": false
  },
  "tight_hysteretic_deadband": {
