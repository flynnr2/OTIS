{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:otis:schema:run-evidence:v1",
  "title": "OTIS immutable run evidence snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_state",
    "digest_algorithm",
    "artifacts",
    "snapshot_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_state": {
      "enum": ["complete", "partial"]
    },
    "digest_algorithm": {
      "const": "sha256"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "size_bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "run_manifest",
              "configuration",
              "profile_snapshot",
              "raw_evidence",
              "declared_artifact"
            ]
          },
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
