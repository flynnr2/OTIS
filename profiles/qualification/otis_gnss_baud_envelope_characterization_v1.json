  "classification": {
    "steady_online_classes": [
      "operationally_feasible_observed", "operationally_feasible_low_margin",
      "nominally_clean_insufficient_evidence", "transport_unstable",
      "platform_confounded", "not_exercised"
    ],
    "transition_classes": [
      "transition_reliable_observed", "transition_unreliable",
      "transition_platform_confounded", "transition_not_assessed"
    ],
    "operationally_feasible_observed_requires": [
      "zero ordinary-online UART hardware errors in both visits",
      "zero ordinary-online raw-ring overflows in both visits",
      "zero ordinary-online checksum truncation oversize and parser-drop events in both visits",
      "zero transport-caused metadata holds in ordinary and peak phases",
      "exact identity and output configuration throughout",
      "no D14/D8 or shared-platform degradation",
      "no evidence that the ISR failed to drain available hardware bytes",
      "ring high water no greater than 512 of 1024 entries under the largest ordinary or peak-load gap"
    ],
    "transition_reliable_observed_requires": "every scheduled entry and exit involving the baud completes within the frozen deadline and binds the first dependent snapshot",
    "zero_event_bound": {"method": "one_sided_95_percent_Poisson_approximation", "formula": "3/N", "claim_limit": "finite_empirical_bound_not_timeless_probability_or_independence"}
  },
  "causal_fault_priority": [
