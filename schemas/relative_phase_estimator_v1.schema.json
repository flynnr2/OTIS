{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otis.local/schemas/relative_phase_estimator_v1.schema.json",
  "title": "OTIS relative phase estimator v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "oscillator_identity",
    "frequency_estimator_id",
    "selection",
    "epoch_and_reset",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"const": "OTIS_RELATIVE_PHASE_ESTIMATOR_V1"},
    "status": {"const": "selected_production_estimator"},
    "oscillator_identity": {"const": "CX317"},
    "frequency_estimator_id": {"const": "OTIS_PPS_GATED_FREQUENCY_ESTIMATOR_V1"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_phase_method", "filtered_phase_method", "frequency_support_intervals"],
      "properties": {
        "raw_phase_method": {"const": "D14_REFERENCED_D8_RELATIVE_PHASE_ACCUMULATOR_V1"},
        "filtered_phase_method": {"const": "identity_from_raw_relative_phase_no_smoothing"},
        "frequency_support_intervals": {"const": 600}
      }
    },
    "epoch_and_reset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new_raw_epoch_on", "preserve_raw_epoch_on", "no_guessed_epoch_offset"],
      "properties": {
        "new_raw_epoch_on": {
          "const": [
            "capture_session_change",
            "reset",
            "unbridgeable_D14_discontinuity",
            "snapshot_sequence_or_association_discontinuity",
            "ambiguous_counter_wrap",
            "D14_invalid_or_stale"
          ]
        },
        "preserve_raw_epoch_on": {
          "const": [
            "healthy_dac_epoch_transition",
            "visible_phase_step_with_valid_continuity",
            "D10_external_event_anomaly"
          ]
        },
        "no_guessed_epoch_offset": {"const": true}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_relative_phase_cycles", "phase_zero"],
      "properties": {
        "raw_relative_phase_cycles": {"const": "exact_integer_accumulator"},
        "phase_zero": {"const": "arbitrary_at_first_qualified_boundary_of_each_phase_epoch"}
      }
    }
  }
}
