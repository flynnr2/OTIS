    "counter_direction": "down",
    "interval_edges_rule": "(previous_cumulative_down_counter-current_cumulative_down_counter)_mod_2^32",
    "edge_error_rule": "interval_edges-10000000"
  },
  "raw_relative_phase_observation": {
    "record_type": "RPH",
    "record_schema_version": 1,
    "phase_zero": "arbitrary_at_first_qualified_boundary_of_each_phase_epoch",
    "positive_sign_meaning": "oscillator_produced_excess_cycles_and_is_inferred_advanced_relative_to_nominal_pps_interval_sequence",
    "accumulation_rule": "sum_accepted_interval_edge_error_within_phase_epoch",
    "time_conversion_rule": "relative_phase_cycles_times_100_ns",
    "required_identity_fields": [
      "phase_epoch",
      "observation_sequence",
      "capture_session",
      "opening_snapshot_sequence",
      "closing_snapshot_sequence",
      "opening_reference_sequence",
      "closing_reference_sequence",
      "dac_epoch",
      "source_backend",
      "source_file_sha256",
      "method_id",
      "configuration_sha256"
    ],
    "required_value_fields": [
      "interval_edges",
      "edge_error_cycles",
      "relative_phase_cycles",
      "relative_phase_time_ns",
      "qualification_state",
      "observation_age_s",
      "discontinuity_reason",
      "calibrated_uncertainty_status"
    ],
    "calibrated_uncertainty_default": "unavailable",
    "raw_source_preserved": true
  },
  "phase_estimator_output": {
    "record_type": "PHE",
    "record_schema_version": 1,
    "required_fields": [
      "phase_epoch",
      "observation_sequence",
      "source_relative_phase_observation",
      "raw_relative_phase_cycles",
      "raw_relative_phase_time_ns",
