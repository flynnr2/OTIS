    "unknown_schema_version": "protocol_discrepancy_hold"
  },
  "commands": {
    "forms": {
      "active_arm": {
        "acknowledgement": "STS adaptive_hybrid.arm",
        "arguments": [
          {
            "maximum": 4294967295,
            "minimum": 1,
            "name": "authorization_sequence",
            "wire_type": "uint32"
          },
          {
            "maximum": 4294967295,
            "minimum": 1,
            "name": "nonce",
            "wire_type": "uint32"
          },
          {
            "maximum": 4294967295,
            "minimum": 1,
            "name": "expires_s",
            "wire_type": "uint32"
          }
        ],
        "first_consumer": "firmware adaptive hybrid authority state",
        "prefix": "ACTIVE ARM"
      },
      "active_evidence": {
        "acknowledgement": "STS adaptive_hybrid.evidence_ack",
        "arguments": [
          {
            "maximum": 4294967295,
            "minimum": 1,
            "name": "request_sequence",
            "wire_type": "uint32"
          },
          {
            "name": "phase",
            "values": [
              1,
              2,
              3,
              4
            ],
            "wire_type": "enum_uint32"
          }
        ],
        "first_consumer": "firmware transaction evidence phase state",
        "prefix": "ACTIVE EVIDENCE"
      },
      "active_lease": {
        "acknowledgement": "STS adaptive_hybrid.capture_lease",
        "arguments": [
          {
            "maximum": 4294967295,
            "minimum": 1,
            "name": "capture_lease_sequence",
            "wire_type": "uint32"
          }
        ],
        "first_consumer": "firmware queue_dual_core_active_control(CaptureLease)",
        "prefix": "ACTIVE LEASE"
      },
      "active_setup": {
        "acknowledgement": "STS adaptive_hybrid_setup.phase plus exact identity fields",
        "arguments": [
          {
            "maximum": 4294967295,
            "minimum": 1,
            "name": "authorization_sequence",
            "wire_type": "uint32"
          },
          {
            "maximum": 4294967295,
            "minimum": 1,
            "name": "status_generation",
            "wire_type": "uint32"
          },
          {
            "maximum": 4294967295,
            "minimum": 1,
            "name": "query_nonce",
            "wire_type": "uint32"
          },
          {
            "maximum": 4294967295,
            "minimum": 1,
            "name": "expires_s",
            "wire_type": "uint32"
          },
          {
            "maximum": 4294967295,
            "minimum": 1,
            "name": "session_id",
            "wire_type": "uint32"
          },
          {
            "maximum": 65535,
            "minimum": 0,
            "name": "setup_code",
            "wire_type": "uint16"
          },
          {
            "maximum": 65535,
            "minimum": 1,
            "name": "ordinal",
            "wire_type": "uint16"
          },
          {
            "name": "configuration_sha256",
            "wire_type": "lower_hex_sha256"
          }
        ],
        "first_consumer": "firmware setup authority guard",
        "prefix": "ACTIVE SETUP"
      },
      "active_snapshot": {
        "acknowledgement": "complete solicited active status generation",
        "arguments": [
          {
            "maximum": 4294967295,
            "minimum": 1,
            "name": "query_nonce",
            "wire_type": "uint32"
          }
        ],
        "first_consumer": "host ActiveStatusLiveReducer",
        "prefix": "ACTIVE SNAPSHOT"
      }
    },
    "priority_only": [
      "ACTIVE ABORT"
    ],
    "simple": [
      "HELP",
      "CONFIG?",
      "DUALCORE?",
      "DAC?",
      "DAC LIMITS?",
      "COUNT?",
      "ACTIVE?",
      "ACTIVE ABORT"
    ],
    "timestamp_envelope": {
      "prefix": "OTISQ1",
      "timestamp": "positive_host_monotonic_ns",
      "wire_scope": "host_fifo_only_not_sent_to_firmware"
    },
    "unknown_command": "reject"
  },
