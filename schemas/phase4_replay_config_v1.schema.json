{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otis.local/schemas/phase4_replay_config_v1.schema.json",
  "title": "OTIS Phase 4 host replay configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "startup_inhibit_s",
    "clean_window_requirement",
    "recovery_clean_window_requirement",
    "estimator_window",
    "minimum_estimator_samples",
    "reference_nominal_interval_s",
    "reference_interval_tolerance_s",
    "reference_max_age_s",
    "count_max_age_s",
    "maximum_dispersion_hz",
    "drift_estimation_enabled"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "startup_inhibit_s": { "type": "number", "minimum": 0 },
    "clean_window_requirement": { "type": "integer", "minimum": 1 },
    "recovery_clean_window_requirement": { "type": "integer", "minimum": 1 },
    "estimator_window": { "type": "integer", "minimum": 1 },
    "minimum_estimator_samples": { "type": "integer", "minimum": 1 },
    "reference_nominal_interval_s": { "type": "number", "exclusiveMinimum": 0 },
    "reference_interval_tolerance_s": { "type": "number", "minimum": 0 },
    "reference_max_age_s": { "type": "number", "minimum": 0 },
    "count_max_age_s": { "type": "number", "minimum": 0 },
    "maximum_dispersion_hz": { "type": "number", "minimum": 0 },
    "drift_estimation_enabled": { "const": false }
  }
}
