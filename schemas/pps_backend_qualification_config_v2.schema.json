{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otis.local/schemas/pps_backend_qualification_config_v2.schema.json",
  "title": "OTIS PPS-gated digital-architecture qualification configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acceptance_scope",
    "criteria_rationale_document",
    "candidate_estimator_type",
    "expected_candidate_backend",
    "allowed_independent_paths",
    "nominal_reference_interval_s",
    "reference_interval_tolerance_s",
    "duplicate_max_interval_s",
    "missing_timeout_s",
    "count_resolution_edges",
    "minimum_stable_duration_s",
    "minimum_eligible_windows",
    "minimum_service_plane_windows_per_segment",
    "absolute_bias_reference_hz",
    "absolute_bias_disposition",
    "candidate_population_jitter_reference_hz",
    "candidate_population_jitter_disposition",
    "service_plane_mean_shift_reference_hz",
    "service_plane_mean_shift_disposition",
    "required_fault_reason_codes",
    "synthetic_only_fault_reason_codes"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "acceptance_scope": { "const": "digital_architecture" },
    "criteria_rationale_document": { "type": "string", "minLength": 1 },
    "candidate_estimator_type": { "const": "pps_gated_ratio_count_v1" },
    "expected_candidate_backend": {
      "const": "OTIS_TCXO_COUNTER_BACKEND_PPS_GATED_RATIO"
    },
    "allowed_independent_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["estimator_type", "measurement_backend"],
        "properties": {
          "estimator_type": { "type": "string", "minLength": 1 },
          "measurement_backend": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nominal_reference_interval_s": { "type": "number", "exclusiveMinimum": 0 },
    "reference_interval_tolerance_s": { "type": "number", "minimum": 0 },
    "duplicate_max_interval_s": { "type": "number", "exclusiveMinimum": 0 },
    "missing_timeout_s": { "type": "number", "exclusiveMinimum": 0 },
    "count_resolution_edges": { "type": "integer", "minimum": 1 },
    "minimum_stable_duration_s": { "type": "number", "exclusiveMinimum": 0 },
    "minimum_eligible_windows": { "type": "integer", "minimum": 1 },
    "minimum_service_plane_windows_per_segment": { "type": "integer", "minimum": 1 },
    "absolute_bias_reference_hz": { "type": "number", "minimum": 0 },
    "absolute_bias_disposition": { "const": "characterization_only" },
    "candidate_population_jitter_reference_hz": { "type": "number", "minimum": 0 },
    "candidate_population_jitter_disposition": { "const": "blocking_architecture_screen" },
    "service_plane_mean_shift_reference_hz": { "type": "number", "minimum": 0 },
    "service_plane_mean_shift_disposition": { "const": "characterization_only" },
    "required_fault_reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "synthetic_only_fault_reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
