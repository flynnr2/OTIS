{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otis.local/schemas/plant_model_v1.schema.json",
  "title": "OTIS selected oscillator plant model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "status",
    "oscillator",
    "topology",
    "control_range",
    "response",
    "invalidation_conditions",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "model_id": {"const": "OTIS_PPS_GATED_OSCILLATOR_PLANT_V1"},
    "status": {"const": "selected_production_model"},
    "oscillator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part", "nominal_frequency_hz", "supply_voltage_v"],
      "properties": {
        "part": {"const": "CX317 VCOCXO"},
        "nominal_frequency_hz": {"const": 10000000},
        "supply_voltage_v": {"const": 3.292}
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_input",
        "oscillator_count_input",
        "external_event_input",
        "external_event_authority",
        "dac",
        "dac_i2c_address"
      ],
      "properties": {
        "reference_input": {"const": "D14"},
        "oscillator_count_input": {"const": "D8"},
        "external_event_input": {"const": "D10"},
        "external_event_authority": {"const": false},
        "dac": {"const": "AD5693R"},
        "dac_i2c_address": {"const": "0x4C"}
      }
    },
    "control_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_code", "maximum_code", "nominal_code"],
      "properties": {
        "minimum_code": {"const": 43008},
        "maximum_code": {"const": 43776},
        "nominal_code": {"const": 43344}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gain_sign",
        "minimum_hz_per_code",
        "nominal_hz_per_code",
        "maximum_hz_per_code",
        "settling_exclusion_s",
        "selected_control_cadence_s",
        "observed_temperature_min_c",
        "observed_temperature_max_c",
        "temperature_role"
      ],
      "properties": {
        "gain_sign": {"const": "positive"},
        "minimum_hz_per_code": {"const": 0.00016357422282453626},
        "nominal_hz_per_code": {"const": 0.00017008467693813145},
        "maximum_hz_per_code": {"const": 0.00017334010044578463},
        "settling_exclusion_s": {"const": 900},
        "selected_control_cadence_s": {"const": 1800},
        "observed_temperature_min_c": {"const": 27.259},
        "observed_temperature_max_c": {"const": 30.851},
        "temperature_role": {"const": "nearby_air_telemetry_covariate_only"}
      }
    },
    "invalidation_conditions": {
      "const": [
        "physical oscillator DAC conditioning D14 D8 or shared power topology changes",
        "DAC code leaves 0xA800..0xAB00",
        "measurement backend or selected estimator semantics change",
        "a span crosses a DAC epoch settling exclusion invalid interval session boundary sequence discontinuity or capture fault",
        "D10 is used as a PPS observer reference witness control input health veto or run terminal"
      ]
    },
    "limitations": {
      "const": [
        "calibrated connected control voltage and combined uncertainty are unavailable",
        "nearby air temperature is context and not a control eligibility bound",
        "D10 is optional external event evidence only"
      ]
    }
  }
}
